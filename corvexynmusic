    // DB Init
    const dbName = "CorvexynMediaDB";
    let dbInstance = null;

    function initDB() {
      return new Promise((resolve) => {
        const req = indexedDB.open(dbName, 1);
        req.onupgradeneeded = (e) => {
          const db = e.target.result;
          if (!db.objectStoreNames.contains("mediaFiles")) db.createObjectStore("mediaFiles");
        };
        req.onsuccess = (e) => { dbInstance = e.target.result; resolve(dbInstance); };
        req.onerror = () => resolve(null);
      });
    }

    async function saveMediaToDB(key, dataUrl) {
      if (!dbInstance) await initDB();
      if (!dbInstance) return;
      return new Promise((resolve) => {
        try {
          const tx = dbInstance.transaction("mediaFiles", "readwrite");
          const store = tx.objectStore("mediaFiles");
          const req = store.put(dataUrl, key);
          req.onsuccess = () => resolve();
          req.onerror = () => resolve();
        } catch(e) { resolve(); }
      });
    }

    async function getMediaFromDB(key) {
      if (!dbInstance) await initDB();
      if (!dbInstance) return null;
      return new Promise((resolve) => {
        try {
          const tx = dbInstance.transaction("mediaFiles", "readonly");
          const store = tx.objectStore("mediaFiles");
          const req = store.get(key);
          req.onsuccess = () => resolve(req.result || null);
          req.onerror = () => resolve(null);
        } catch(e) { resolve(null); }
      });
    }

    function dataURLtoBlobUrl(dataurl) {
      if (!dataurl) return null;
      try {
        if (dataurl.startsWith('blob:') || dataurl.startsWith('http')) return dataurl;
        const arr = dataurl.split(',');
        const mime = arr[0].match(/:(.*?);/)[1];
        const bstr = atob(arr[1]);
        let n = bstr.length;
        const u8arr = new Uint8Array(n);
        while (n--) u8arr[n] = bstr.charCodeAt(n);
        const blob = new Blob([u8arr], { type: mime });
        return URL.createObjectURL(blob);
      } catch(e) { return dataurl; }
    }

    // PIN Verification
    let inputPin = "";
    function pressPin(digit) {
      if (inputPin.length < 4) {
        inputPin += digit;
        updatePinDots();
        if (inputPin.length === 4) verifyPin();
      }
    }
    function backspacePin() {
      if (inputPin.length > 0) {
        inputPin = inputPin.slice(0, -1);
        updatePinDots();
      }
    }
    function clearPin() {
      inputPin = "";
      updatePinDots();
    }
    function updatePinDots() {
      for (let i = 0; i < 4; i++) {
        const dot = document.getElementById(`dot-${i}`);
        if (i < inputPin.length) {
          dot.classList.add('bg-indigo-500', 'border-indigo-400');
          dot.classList.remove('bg-slate-800/50', 'border-slate-700');
        } else {
          dot.classList.remove('bg-indigo-500', 'border-indigo-400');
          dot.classList.add('bg-slate-800/50', 'border-slate-700');
        }
      }
    }
    function verifyPin() {
      if (inputPin === PIN_PASSCODE) {
        document.getElementById('pin-modal').classList.add('hidden');
        document.getElementById('app-container').classList.remove('hidden');
        initializeApp();
      } else {
        const errEl = document.getElementById('pin-error');
        errEl.classList.remove('opacity-0');
        setTimeout(() => {
          errEl.classList.add('opacity-0');
          inputPin = "";
          updatePinDots();
        }, 1200);
      }
    }

