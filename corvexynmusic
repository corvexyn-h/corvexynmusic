      const container = document.getElementById('screen-container');
      container.onmousemove = () => {
        if (document.fullscreenElement || document.webkitFullscreenElement || container.classList.contains('mobile-fake-fullscreen')) {
          showFsControls();
          resetFsTimer();
        }
      };
      container.ontouchstart = () => {
        if (document.fullscreenElement || document.webkitFullscreenElement || container.classList.contains('mobile-fake-fullscreen')) {
          showFsControls();
          resetFsTimer();
        }
      };

      document.addEventListener('fullscreenchange', handleFsChange);
      document.addEventListener('webkitfullscreenchange', handleFsChange);
    }

    function handleFsChange() {
      const isFs = !!(document.fullscreenElement || document.webkitFullscreenElement);
      const fsControls = document.getElementById('fs-floating-controls');
      if (isFs) {
        fsControls.classList.remove('fs-controls-hidden');
        fsControls.classList.add('fs-controls-visible');
        resetFsTimer();
      } else {
        const container = document.getElementById('screen-container');
        if (!container.classList.contains('mobile-fake-fullscreen')) {
          fsControls.classList.remove('fs-controls-visible');
          fsControls.classList.add('fs-controls-hidden');
          document.getElementById('fs-playlist-drawer').classList.add('translate-x-full');
        }
      }
    }

    function resetFsTimer() {
      if (fsControlsTimer) clearTimeout(fsControlsTimer);
      fsControlsTimer = setTimeout(() => {
        const container = document.getElementById('screen-container');
        if (document.fullscreenElement || document.webkitFullscreenElement || container.classList.contains('mobile-fake-fullscreen')) {
          const fsControls = document.getElementById('fs-floating-controls');
          fsControls.classList.remove('fs-controls-visible');
          fsControls.classList.add('fs-controls-hidden');
        }
      }, 4000);
    }

    function showFsControls() {
      const fsControls = document.getElementById('fs-floating-controls');
      fsControls.classList.remove('fs-controls-hidden');
      fsControls.classList.add('fs-controls-visible');
    }

    function toggleFsDrawer() {
      const drawer = document.getElementById('fs-playlist-drawer');
      drawer.classList.toggle('translate-x-full');
      renderFsDrawerTracks();
    }

    function renderFsDrawerTracks() {
      const list = document.getElementById('fs-drawer-track-list');
      list.innerHTML = '';
      const tracks = getCurrentPlaylist().tracks;
      tracks.forEach((t, idx) => {
        const isCur = idx === window.currentTrackIndex;
        const div = document.createElement('div');
        div.className = `p-2.5 rounded-xl flex items-center justify-between text-xs cursor-pointer transition ${isCur ? 'bg-indigo-600 text-white font-bold shadow-md' : 'bg-slate-800/80 hover:bg-slate-700 text-slate-300'}`;
        
        let playingIndicator = isCur ? '<i class="fa-solid fa-volume-high text-emerald-400 animate-pulse-fast ml-2 flex-shrink-0"></i>' : '';

        div.innerHTML = `
          <div class="flex items-center justify-between w-full min-w-0">
            <span class="truncate pr-2 min-w-0 flex-1">${escapeHtml(t.title)}</span>
            <div class="flex items-center gap-1 flex-shrink-0">
              <span class="text-[10px] opacity-70">${escapeHtml(t.artist)}</span>
              ${playingIndicator}
            </div>
          </div>
        `;
        div.onclick = () => { 
          playTrack(idx); 
          renderFsDrawerTracks(); 
        };
        list.appendChild(div);
      });
    }

    function switchTab(type) {
      document.getElementById('form-youtube').classList.add('hidden');
      document.getElementById('form-mp3').classList.add('hidden');
      document.getElementById('form-mp4').classList.add('hidden');
      document.getElementById('tab-yt-btn').className = "flex-1 py-1.5 rounded-lg font-semibold text-slate-400 transition";
      document.getElementById('tab-mp3-btn').className = "flex-1 py-1.5 rounded-lg font-semibold text-slate-400 transition";
      document.getElementById('tab-mp4-btn').className = "flex-1 py-1.5 rounded-lg font-semibold text-slate-400 transition";

      document.getElementById(`form-${type}`).classList.remove('hidden');
      document.getElementById(`tab-${type}-btn`).className = "flex-1 py-1.5 rounded-xl font-semibold bg-indigo-600 text-white transition shadow";
    }

    function openSettingsModal() { document.getElementById('settings-modal').classList.remove('hidden'); }
    function closeSettingsModal() { document.getElementById('settings-modal').classList.add('hidden'); }
    function openLyricsEditor() {
      const tracks = getCurrentPlaylist().tracks;
      if (window.currentTrackIndex < 0 || !tracks[window.currentTrackIndex]) { alert(t('alertNoTrack')); return; }
      document.getElementById('lyrics-textarea').value = tracks[window.currentTrackIndex].lyrics || '';
      document.getElementById('lyrics-modal').classList.remove('hidden');
    }
    function closeLyricsEditor() { document.getElementById('lyrics-modal').classList.add('hidden'); }
    function saveLyrics() {
      const tracks = getCurrentPlaylist().tracks;
      if (window.currentTrackIndex >= 0 && tracks[window.currentTrackIndex]) {
        tracks[window.currentTrackIndex].lyrics = document.getElementById('lyrics-textarea').value;
        parseLyrics(tracks[window.currentTrackIndex].lyrics);
        saveLocalStorage();
      }
      closeLyricsEditor();
    }

    const audioEngine = document.getElementById('audio-engine');
    audioEngine.volume = 0.8;
    audioEngine.preservesPitch = true;

    function getCurrentPlaylist() {
      return window.playlists.find(p => p.id === window.currentPlaylistId) || window.playlists[0];
    }

    async function stopAllEngines() {
      try {
        audioEngine.pause();
        audioEngine.currentTime = 0;
        audioEngine.src = "";
      } catch(e) {}
      
      const videoEl = document.getElementById('mp4-video-engine');
      try {
        videoEl.pause();
        videoEl.currentTime = 0;
        videoEl.removeAttribute('src');
        videoEl.load();
      } catch(e) {}

      if (window.ytPlayer && typeof window.ytPlayer.stopVideo === 'function') {
        try { window.ytPlayer.stopVideo(); } catch(e) {}
      }
    }

    function createOrPlayYoutube(videoId) {
      const ytBox = document.getElementById('youtube-box');
      
      const onPlayerStateChange = (e) => {
        // [중요] 유튜브 트랙 종료 이벤트 발생 시 곧바로 다음 곡 자동 연동
        if (e.data === YT.PlayerState.ENDED) {
          handleTrackEnded();
        } else if (e.data === YT.PlayerState.PLAYING) {
          window.isPlaying = true;
          updatePlayPauseUI();
          try {
            if (window.ytPlayer && typeof window.ytPlayer.setPlaybackQuality === 'function') {
              window.ytPlayer.setPlaybackQuality('small');
            }
          } catch(err) {}
        } else if (e.data === YT.PlayerState.PAUSED) {
          window.isPlaying = false;
          updatePlayPauseUI();
        }
      };

      if (!window.ytPlayer || typeof window.ytPlayer.loadVideoById !== 'function') {
        ytBox.innerHTML = '<div id="yt-player-target" class="w-full h-full"></div>';
        
        window.ytPlayer = new YT.Player('yt-player-target', {
          height: '100%',
          width: '100%',
          videoId: videoId,
          playerVars: { 
            'autoplay': 1, 
            'controls': 0,
            'disablekb': 1,
            'playsinline': 1,
            'rel': 0,
            'modestbranding': 1,
            'enablejsapi': 1,
            'vq': 'small'
          },
          events: {
            'onReady': (e) => {
              window.isYtReady = true;
              try {
                e.target.setPlaybackQuality('small');
                e.target.playVideo();
                e.target.setVolume(Math.round(audioEngine.volume * 100));
              } catch(err) {}
            },
            'onStateChange': onPlayerStateChange,
            'onError': (e) => {
              console.warn("YouTube Player error:", e.data);
              setTimeout(() => playNextTrack(), 1000);
            }
          }
        });
      } else {
        try {
          window.ytPlayer.loadVideoById({ videoId: videoId, suggestedQuality: 'small' });
          window.ytPlayer.playVideo();
          window.ytPlayer.setVolume(Math.round(audioEngine.volume * 100));
        } catch(e) {
          ytBox.innerHTML = '<div id="yt-player-target" class="w-full h-full"></div>';
          window.ytPlayer = null;
          setTimeout(() => createOrPlayYoutube(videoId), 100);
        }
      }
    }

    async function playTrack(index) {
      const tracks = getCurrentPlaylist().tracks;
      if (index < 0 || index >= tracks.length) return;
      
      triggerMelonKeepAlive();
      await stopAllEngines();

      window.currentTrackIndex = index;
      const track = tracks[index];

      document.getElementById('bar-title').textContent = track.title;
      document.getElementById('bar-artist').textContent = track.artist;
      const fsTitle = document.getElementById('fs-bar-title');
      const fsArtist = document.getElementById('fs-bar-artist');
      if (fsTitle) fsTitle.textContent = track.title;
      if (fsArtist) fsArtist.textContent = track.artist;

      parseLyrics(track.lyrics || '');
      renderTracks();
      renderFsDrawerTracks();
      updateMediaSessionMetadata(track);

      const videoContainer = document.getElementById('video-display-container');
      const ytBox = document.getElementById('youtube-box');
      const discView = document.getElementById('disc-view');
      const videoEl = document.getElementById('mp4-video-engine');

      videoContainer.classList.add('hidden');
      ytBox.classList.add('hidden');
      discView.classList.remove('hidden');

      if (track.type === 'youtube') {
        discView.classList.add('hidden');
        ytBox.classList.remove('hidden');
        createOrPlayYoutube(track.src);
        window.isPlaying = true;
        updatePlayPauseUI();
      } else if (track.type === 'mp3') {
        let rawData = await getMediaFromDB(track.id) || await getMediaFromDB(track.src) || track.fileData;
        if (rawData) {
          audioEngine.src = dataURLtoBlobUrl(rawData);
          audioEngine.load();
          await audioEngine.play().then(() => {
            window.isPlaying = true;
            updatePlayPauseUI();
          }).catch((err) => { console.log("Audio play deferred:", err); });
        } else {
          alert("저장된 오디오 파일을 찾을 수 없습니다.");
        }
      } else if (track.type === 'mp4') {
        discView.classList.add('hidden');
        videoContainer.classList.remove('hidden');
        let rawData = await getMediaFromDB(track.id) || await getMediaFromDB(track.src) || track.fileData;
        if (rawData) {
          videoEl.src = dataURLtoBlobUrl(rawData);
          videoEl.load();
          await videoEl.play().then(() => {
            window.isPlaying = true;
            updatePlayPauseUI();
          }).catch((err) => { console.log("Video play deferred:", err); });
        } else {
          alert("저장된 동영상 파일을 찾을 수 없습니다.");
        }
      }
    }

    function setupAudioListeners() {
      audioEngine.ontimeupdate = () => {
        const tracks = getCurrentPlaylist().tracks;
        if (window.currentTrackIndex >= 0 && tracks[window.currentTrackIndex]?.type === 'mp3') {
          updateProgress(audioEngine.currentTime, audioEngine.duration || 0);
        }
      };
      audioEngine.onended = () => { handleTrackEnded(); };

      const videoEl = document.getElementById('mp4-video-engine');
      videoEl.ontimeupdate = () => {
        const tracks = getCurrentPlaylist().tracks;
        if (window.currentTrackIndex >= 0 && tracks[window.currentTrackIndex]?.type === 'mp4') {
          updateProgress(videoEl.currentTime, videoEl.duration || 0);
        }
      };
      videoEl.onended = () => { handleTrackEnded(); };
    }

    function updateProgress(curr, dur) {
      if (dur > 0) {
        const pct = (curr / dur) * 100;
        
        const mainBar = document.getElementById('progress-bar');
        const fsBar = document.getElementById('fs-progress-bar');
        
        if (mainBar) {
          mainBar.value = pct;
          mainBar.style.background = `linear-gradient(to right, #8b5cf6 0%, #8b5cf6 ${pct}%, rgba(100, 116, 139, 0.3) ${pct}%, rgba(100, 116, 139, 0.3) 100%)`;
        }
        if (fsBar) {
          fsBar.value = pct;
          fsBar.style.background = `linear-gradient(to right, #8b5cf6 0%, #8b5cf6 ${pct}%, rgba(100, 116, 139, 0.3) ${pct}%, rgba(100, 116, 139, 0.3) 100%)`;
        }

        const timeStr = formatTime(curr);
        const durStr = formatTime(dur);
        document.getElementById('current-time').textContent = timeStr;
        document.getElementById('duration').textContent = durStr;
        const fsCur = document.getElementById('fs-current-time');
        const fsDur = document.getElementById('fs-duration');
        if (fsCur) fsCur.textContent = timeStr;
        if (fsDur) fsDur.textContent = durStr;
      }
      updateActiveLyric(curr);
    }

    function formatTime(sec) {
      const m = Math.floor(sec / 60);
      const s = Math.floor(sec % 60);
      return `${m}:${s < 10 ? '0' : ''}${s}`;
    }

    function seekTrack(val) {
      const tracks = getCurrentPlaylist().tracks;
      const track = tracks[window.currentTrackIndex];
      if (!track) return;
      if (track.type === 'mp3' && audioEngine.duration) {
        audioEngine.currentTime = (val / 100) * audioEngine.duration;
      } else if (track.type === 'mp4') {
        const videoEl = document.getElementById('mp4-video-engine');
        if (videoEl.duration) videoEl.currentTime = (val / 100) * videoEl.duration;
      } else if (track.type === 'youtube' && window.ytPlayer && typeof window.ytPlayer.getDuration === 'function') {
        window.ytPlayer.seekTo((val / 100) * window.ytPlayer.getDuration(), true);
      }
    }

    function togglePlayPause() {
      triggerMelonKeepAlive();
      const tracks = getCurrentPlaylist().tracks;
      const track = tracks[window.currentTrackIndex];
      if (!track) {
        if (tracks.length > 0) playTrack(0);
        return;
      }

      if (track.type === 'youtube' && window.ytPlayer) {
        try {
          const state = window.ytPlayer.getPlayerState();
          if (state === YT.PlayerState.PLAYING) {
            window.ytPlayer.pauseVideo();
            window.isPlaying = false;
          } else {
            window.ytPlayer.playVideo();
            window.isPlaying = true;
          }
        } catch(e) {
          createOrPlayYoutube(track.src);
          window.isPlaying = true;
        }
      } else if (track.type === 'mp3') {
        if (audioEngine.paused) {
          audioEngine.play().catch(()=>{});
          window.isPlaying = true;
        } else {
          audioEngine.pause();
          window.isPlaying = false;
        }
      } else if (track.type === 'mp4') {
        const videoEl = document.getElementById('mp4-video-engine');
        if (videoEl.paused) {
          videoEl.play().catch(()=>{});
          window.isPlaying = true;
        } else {
          videoEl.pause();
          window.isPlaying = false;
        }
      }
      updatePlayPauseUI();
    }

    function updatePlayPauseUI() {
      const icon = '<i class="fa-solid fa-pause"></i>';
      const playIcon = '<i class="fa-solid fa-play ml-0.5" id="playIcon"></i>';
      document.getElementById('play-pause-btn').innerHTML = window.isPlaying ? icon : playIcon;
      const fsBtn = document.getElementById('fs-play-pause-btn');
      if (fsBtn) fsBtn.innerHTML = window.isPlaying ? icon : '<i class="fa-solid fa-play ml-0.5" id="fsPlayIcon"></i>';
      renderTracks();
      renderFsDrawerTracks();
    }

    function handleTrackEnded() {
      if (window.isRepeat && window.currentTrackIndex >= 0) {
        playTrack(window.currentTrackIndex);
      } else {
        playNextTrack();
      }
    }

    function playNextTrack() {
      const tracks = getCurrentPlaylist().tracks;
      if (tracks.length === 0) return;
      let next = window.currentTrackIndex + 1;
      if (window.isShuffle) next = Math.floor(Math.random() * tracks.length);
      if (next >= tracks.length) next = 0;
      playTrack(next);
    }

    function playPrevTrack() {
      const tracks = getCurrentPlaylist().tracks;
      if (tracks.length === 0) return;
      let prev = window.currentTrackIndex - 1;
      if (prev < 0) prev = tracks.length - 1;
      playTrack(prev);
    }

    function skipTime(sec) {
      const tracks = getCurrentPlaylist().tracks;
      const track = tracks[window.currentTrackIndex];
      if (!track) return;
      if (track.type === 'mp3') {
        audioEngine.currentTime = Math.max(0, Math.min(audioEngine.duration || 0, audioEngine.currentTime + sec));
      } else if (track.type === 'mp4') {
        const videoEl = document.getElementById('mp4-video-engine');
        videoEl.currentTime = Math.max(0, Math.min(videoEl.duration || 0, videoEl.currentTime + sec));
      } else if (track.type === 'youtube' && window.ytPlayer && typeof window.ytPlayer.getCurrentTime === 'function') {
        const target = Math.max(0, window.ytPlayer.getCurrentTime() + sec);
        window.ytPlayer.seekTo(target, true);
      }
    }

    function setVolume(val) {
      const v = parseFloat(val) / 100;
      audioEngine.volume = v;
      document.getElementById('mp4-video-engine').volume = v;
      if (window.ytPlayer && typeof window.ytPlayer.setVolume === 'function') {
        window.ytPlayer.setVolume(val);
      }
      
      const mainSlider = document.getElementById('volume-slider');
      const fsSlider = document.getElementById('fs-volume-slider');
      
      if (mainSlider) {
        mainSlider.value = val;
        mainSlider.style.background = `linear-gradient(to right, #10b981 0%, #10b981 ${val}%, rgba(100, 116, 139, 0.3) ${val}%, rgba(100, 116, 139, 0.3) 100%)`;
      }
      if (fsSlider) {
        fsSlider.value = val;
        fsSlider.style.background = `linear-gradient(to right, #10b981 0%, #10b981 ${val}%, rgba(100, 116, 139, 0.3) ${val}%, rgba(100, 116, 139, 0.3) 100%)`;
      }

      const muteIcon = v === 0 ? '<i class="fa-solid fa-volume-xmark text-rose-400"></i>' : '<i class="fa-solid fa-volume-high"></i>';
      document.getElementById('mute-btn').innerHTML = muteIcon;
      document.getElementById('fs-mute-btn').innerHTML = muteIcon;
    }

    function toggleMute() {
      const slider = document.getElementById('volume-slider');
      if (audioEngine.volume > 0) {
        window.previousVolume = slider.value;
        setVolume(0);
      } else {
        setVolume(window.previousVolume || 80);
      }
    }

    function setPlaybackSpeed(spd) {
      const rate = parseFloat(spd);
      audioEngine.playbackRate = rate;
      document.getElementById('mp4-video-engine').playbackRate = rate;
      if (window.ytPlayer && typeof window.ytPlayer.setPlaybackRate === 'function') window.ytPlayer.setPlaybackRate(rate);
    }

    function toggleShuffle() {
      window.isShuffle = !window.isShuffle;
      document.getElementById('shuffle-btn').style.color = window.isShuffle ? '#8b5cf6' : '';
    }

    function toggleRepeat() {
      window.isRepeat = !window.isRepeat;
      document.getElementById('repeat-btn').style.color = window.isRepeat ? '#8b5cf6' : '';
    }

    function renderPlaylists() {
      const listEl = document.getElementById('playlist-list');
      listEl.innerHTML = '';
      window.playlists.forEach(pl => {
        const isSel = pl.id === window.currentPlaylistId;
        const btn = document.createElement('button');
        btn.className = `w-full text-left px-3.5 py-2.5 rounded-2xl text-xs font-semibold flex items-center justify-between transition ${isSel ? 'bg-indigo-600 text-white shadow' : 'bg-slate-100 dark:bg-slate-950/60 hover:bg-slate-200 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300'}`;
        btn.innerHTML = `<span><i class="fa-solid fa-folder mr-2"></i> ${escapeHtml(pl.name)}</span><span class="text-[10px] opacity-80">${pl.tracks.length}${window.currentLang === 'en' ? ' tracks' : '곡'}</span>`;
        btn.onclick = () => { window.currentPlaylistId = pl.id; window.currentTrackIndex = -1; renderPlaylists(); renderTracks(); };
        listEl.appendChild(btn);
      });
    }

    function renderTracks() {
      const listEl = document.getElementById('track-list');
      listEl.innerHTML = '';
      const pl = getCurrentPlaylist();
      document.getElementById('current-playlist-title').innerHTML = `<i class="fa-solid fa-music text-indigo-500"></i> ${escapeHtml(pl.name)}`;
      document.getElementById('track-count-badge').textContent = `${pl.tracks.length}${window.currentLang === 'en' ? ' tracks' : '곡'}`;

      if (pl.tracks.length === 0) {
        listEl.innerHTML = `<div class="text-center py-8 text-xs text-slate-400">${t('noTrack')}</div>`;
        return;
      }

      pl.tracks.forEach((track, idx) => {
        const isCur = idx === window.currentTrackIndex;
        const div = document.createElement('div');
        div.className = `flex items-center justify-between p-3 rounded-2xl border text-xs transition ${isCur ? 'bg-indigo-500/10 border-indigo-500/50 text-indigo-600 dark:text-indigo-400 font-bold' : 'bg-slate-50 dark:bg-slate-950/40 border-slate-200 dark:border-slate-800 hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-200'}`;
        
        let badge = track.type === 'youtube' ? '<span class="text-[9px] bg-red-500/10 text-red-500 font-bold px-1.5 py-0.5 rounded flex-shrink-0">YT</span>' : track.type === 'mp3' ? '<span class="text-[9px] bg-emerald-500/10 text-emerald-500 font-bold px-1.5 py-0.5 rounded flex-shrink-0">MP3</span>' : '<span class="text-[9px] bg-purple-500/10 text-purple-500 font-bold px-1.5 py-0.5 rounded flex-shrink-0">MP4</span>';

        let playingIndicator = isCur ? '<i class="fa-solid fa-volume-high text-emerald-400 animate-pulse-fast ml-1 flex-shrink-0"></i>' : '';

        div.innerHTML = `
          <div class="flex items-center space-x-2.5 min-w-0 flex-1 cursor-pointer" onclick="playTrack(${idx})">
            <span class="w-5 text-center text-slate-400 font-mono flex-shrink-0">${idx + 1}</span>
            ${badge}
            <div class="min-w-0 flex-1 flex items-center gap-1.5">
              <p class="truncate font-semibold min-w-0 flex-1">${escapeHtml(track.title)}</p>
              ${playingIndicator}
            </div>
          </div>
          <div class="flex items-center gap-1 flex-shrink-0 ml-2">
            <button onclick="openPlaylistSelectModal(${idx})" class="p-1.5 text-slate-400 hover:text-emerald-400 transition" title="다른 재생목록에 추가 [+]"><i class="fa-solid fa-plus text-[10px]"></i></button>
            <button onclick="moveTrack(${idx}, 'up')" class="p-1.5 text-slate-400 hover:text-indigo-400 transition" title="한 칸 위로"><i class="fa-solid fa-arrow-up text-[10px]"></i></button>
            <button onclick="moveTrack(${idx}, 'down')" class="p-1.5 text-slate-400 hover:text-indigo-400 transition" title="한 칸 아래로"><i class="fa-solid fa-arrow-down text-[10px]"></i></button>
            <button onclick="moveTrack(${idx}, 'top')" class="p-1.5 text-slate-400 hover:text-indigo-400 transition" title="맨 위로"><i class="fa-solid fa-angles-up text-[10px]"></i></button>
            <button onclick="moveTrack(${idx}, 'bottom')" class="p-1.5 text-slate-400 hover:text-indigo-400 transition" title="맨 아래로"><i class="fa-solid fa-angles-down text-[10px]"></i></button>
            <button onclick="deleteTrack(${idx})" class="p-1.5 text-slate-400 hover:text-rose-500 transition" title="삭제"><i class="fa-solid fa-trash-can text-[10px]"></i></button>
          </div>
        `;
        listEl.appendChild(div);
      });

      if (window.currentTrackIndex >= 0 && listEl.children[window.currentTrackIndex]) {
        try {
          listEl.children[window.currentTrackIndex].scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        } catch(e) {}
      }
    }

    function moveTrack(idx, direction) {
      const tracks = getCurrentPlaylist().tracks;
      if (direction === 'up' && idx > 0) {
        const item = tracks.splice(idx, 1)[0];
        tracks.splice(idx - 1, 0, item);
        if (window.currentTrackIndex === idx) window.currentTrackIndex = idx - 1;
        else if (window.currentTrackIndex === idx - 1) window.currentTrackIndex = idx;
      } else if (direction === 'down' && idx < tracks.length - 1) {
        const item = tracks.splice(idx, 1)[0];
        tracks.splice(idx + 1, 0, item);
        if (window.currentTrackIndex === idx) window.currentTrackIndex = idx + 1;
        else if (window.currentTrackIndex === idx + 1) window.currentTrackIndex = idx;
      } else if (direction === 'top' && idx > 0) {
        const item = tracks.splice(idx, 1)[0];
        tracks.unshift(item);
        if (window.currentTrackIndex === idx) window.currentTrackIndex = 0;
        else if (window.currentTrackIndex < idx && window.currentTrackIndex > 0) window.currentTrackIndex++;
      } else if (direction === 'bottom' && idx < tracks.length - 1) {
        const item = tracks.splice(idx, 1)[0];
        tracks.push(item);
        if (window.currentTrackIndex === idx) window.currentTrackIndex = tracks.length - 1;
        else if (window.currentTrackIndex > idx) window.currentTrackIndex--;
      }
      renderTracks();
      renderFsDrawerTracks();
      saveLocalStorage();
    }

    function createNewPlaylist() {
      const name = prompt(window.currentLang === 'en' ? "Enter new playlist name:" : "새 플레이리스트 이름을 입력하세요:");
      if (!name || !name.trim()) return;
      const newId = 'pl_' + Date.now();
      window.playlists.push({ id: newId, name: name.trim(), tracks: [] });
      window.currentPlaylistId = newId;
      renderPlaylists();
      renderTracks();
      saveLocalStorage();
    }

    function deleteTrack(idx) {
      getCurrentPlaylist().tracks.splice(idx, 1);
      if (window.currentTrackIndex === idx) { stopAllEngines(); window.currentTrackIndex = -1; window.isPlaying = false; updatePlayPauseUI(); }
      else if (window.currentTrackIndex > idx) { window.currentTrackIndex--; }
      renderTracks();
      renderFsDrawerTracks();
      saveLocalStorage();
    }

    function filterTracks(query) {
      const listEl = document.getElementById('track-list');
      const q = query.toLowerCase();
      const pl = getCurrentPlaylist();
      const items = listEl.children;
      pl.tracks.forEach((track, idx) => {
        if (!items[idx]) return;
        const match = track.title.toLowerCase().includes(q) || track.artist.toLowerCase().includes(q);
        items[idx].style.display = match ? 'flex' : 'none';
      });
    }

    let ytFetchDebounce = null;
    function handleYoutubeUrlInput(url) {
      if (ytFetchDebounce) clearTimeout(ytFetchDebounce);
      
      const ytId = extractYouTubeId(url);
      const titleInput = document.getElementById('yt-title');
      const artistInput = document.getElementById('yt-artist');

      if (!ytId) return;

      ytFetchDebounce = setTimeout(() => {
        const targetUrl = `https://www.youtube.com/watch?v=${ytId}`;
        const oembedUrl = `https://noembed.com/embed?url=${encodeURIComponent(targetUrl)}`;

        fetch(oembedUrl)
          .then(res => res.json())
          .then(data => {
            if (data && data.title) {
              titleInput.value = data.title;
              if (data.author_name) artistInput.value = data.author_name;
            } else {
              if (!titleInput.value) titleInput.value = `YouTube Track (${ytId})`;
            }
          })
          .catch(() => {
            if (!titleInput.value) titleInput.value = `YouTube Track (${ytId})`;
          });
      }, 300);
    }

    let cachedMp3DataUrl = null;
    let cachedMp4DataUrl = null;

    function handleMp3FileSelect(e) {
      const file = e.target.files[0];
      if (!file) return;
      document.getElementById('mp3-file-label').textContent = file.name;
      if (!document.getElementById('mp3-title').value) {
        document.getElementById('mp3-title').value = file.name.substring(0, file.name.lastIndexOf('.')) || file.name;
      }
      const reader = new FileReader();
      reader.onload = (evt) => { cachedMp3DataUrl = evt.target.result; };
      reader.readAsDataURL(file);
    }

    function handleMp4FileSelect(e) {
      const file = e.target.files[0];
      if (!file) return;
      document.getElementById('mp4-file-label').textContent = file.name;
      if (!document.getElementById('mp4-title').value) {
        document.getElementById('mp4-title').value = file.name.substring(0, file.name.lastIndexOf('.')) || file.name;
      }
      const reader = new FileReader();
      reader.onload = (evt) => { cachedMp4DataUrl = evt.target.result; };
      reader.readAsDataURL(file);
    }

    async function addMp3Track() {
      const title = document.getElementById('mp3-title').value.trim() || "Untitled MP3";
      const artist = document.getElementById('mp3-artist').value.trim() || "Local Audio";
      if (!cachedMp3DataUrl) { alert("MP3 파일을 선택해주세요."); return; }
      const id = 'mp3_' + Date.now();
      await saveMediaToDB(id, cachedMp3DataUrl);

      getCurrentPlaylist().tracks.push({ id, title, artist, type: 'mp3', src: id, lyrics: '' });
      document.getElementById('mp3-title').value = '';
      document.getElementById('mp3-artist').value = '';
      document.getElementById('mp3-file-label').textContent = t('mp3File');
      cachedMp3DataUrl = null;
      renderTracks();
      renderPlaylists();
      saveLocalStorage();
    }

    async function addMp4Track() {
      const title = document.getElementById('mp4-title').value.trim() || "Untitled Video";
      const artist = document.getElementById('mp4-artist').value.trim() || "Local Video";
      if (!cachedMp4DataUrl) { alert("MP4 파일을 선택해주세요."); return; }
      const id = 'mp4_' + Date.now();
      await saveMediaToDB(id, cachedMp4DataUrl);

      getCurrentPlaylist().tracks.push({ id, title, artist, type: 'mp4', src: id, lyrics: '' });
      document.getElementById('mp4-title').value = '';
      document.getElementById('mp4-artist').value = '';
      document.getElementById('mp4-file-label').textContent = t('mp4File');
      cachedMp4DataUrl = null;
      renderTracks();
      renderPlaylists();
      saveLocalStorage();
    }

    function addYouTubeTrack() {
      const urlInput = document.getElementById('yt-url').value.trim();
      const ytId = extractYouTubeId(urlInput);
      if (!ytId) { alert("올바른 YouTube URL 또는 ID를 입력하세요."); return; }

      const title = document.getElementById('yt-title').value.trim() || `YouTube Track (${ytId})`;
      const artist = document.getElementById('yt-artist').value.trim() || "YouTube";

      getCurrentPlaylist().tracks.push({ id: 'yt_' + Date.now(), title, artist, type: 'youtube', src: ytId, lyrics: '' });
      document.getElementById('yt-title').value = '';
      document.getElementById('yt-artist').value = '';
      document.getElementById('yt-url').value = '';
      renderTracks();
      renderPlaylists();
      saveLocalStorage();
    }

    function extractYouTubeId(url) {
      const match = url.match(/^.*(youtu.be\/|v\/|u\/\w\/|embed\/|watch\?v=|\&v=)([^#\&\?]*).*/);
      return (match && match[2].length === 11) ? match[2] : (url.length === 11 ? url : null);
    }

    function parseLyrics(lrc) {
      const container = document.getElementById('lyrics-container');
      container.innerHTML = '';
      window.currentParsedLyrics = [];
      if (!lrc || !lrc.trim()) {
        container.innerHTML = `<p class="text-slate-400 dark:text-slate-500 text-xs my-auto">${t('lyricsEmpty')}</p>`;
        return;
      }
      lrc.split('\n').forEach((line, idx) => {
        const m = line.match(/\[(\d{2}):(\d{2})\.(\d{2,3})\](.*)/);
        if (m) {
          window.currentParsedLyrics.push({ time: parseInt(m[1]) * 60 + parseInt(m[2]) + parseFloat("0." + m[3]), text: m[4].trim(), id: `lyric-${idx}` });
        }
      });
      window.currentParsedLyrics.forEach(item => {
        const p = document.createElement('p');
        p.id = item.id;
        p.className = "text-slate-400 dark:text-slate-500 text-xs py-1 transition-all lyric-line";
        p.textContent = item.text;
        container.appendChild(p);
      });
    }

    function updateActiveLyric(currTime) {
      if (!window.currentParsedLyrics.length) return;
      let activeIdx = -1;
      for (let i = 0; i < window.currentParsedLyrics.length; i++) {
        if (currTime >= window.currentParsedLyrics[i].time) activeIdx = i;
        else break;
      }
      window.currentParsedLyrics.forEach((item, idx) => {
        const el = document.getElementById(item.id);
        if (el) {
          if (idx === activeIdx) {
            el.classList.add('active');
            try { el.scrollIntoView({ behavior: 'smooth', block: 'center' }); } catch(e) {}
          } else {
            el.classList.remove('active');
          }
        }
      });
    }

    function autoGenerateLyrics() {
      const tracks = getCurrentPlaylist().tracks;
      const track = tracks[window.currentTrackIndex];
      if (!track) { alert(t('alertNoTrack')); return; }
      track.lyrics = `[00:02.00] ♪ ${track.title} (${track.artist}) ♪\n[00:10.00] Corvexyn Music Pro Sync\n[00:25.00] Lyrics scroll automatically with music.`;
      parseLyrics(track.lyrics);
      saveLocalStorage();
    }

    window.onYouTubeIframeAPIReady = function() {
      window.isYtReady = true;
    };

    function exportDataToFile() {
      const slimPlaylists = window.playlists.map(pl => ({
        ...pl,
        tracks: pl.tracks.map(t => { const { fileData, ...rest } = t; return rest; })
      }));
      const blob = new Blob([JSON.stringify({ playlists: slimPlaylists, currentPlaylistId: window.currentPlaylistId }, null, 2)], { type: 'application/json' });
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = `corvexyn_music_backup_${Date.now()}.json`;
      a.click();
    }

    function importDataFromFile(e) {
      const file = e.target.files[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = (evt) => {
        try {
          const parsed = JSON.parse(evt.target.result);
          if (parsed.playlists) {
            window.playlists = parsed.playlists;
            if (parsed.currentPlaylistId) window.currentPlaylistId = parsed.currentPlaylistId;
            renderPlaylists();
            renderTracks();
            alert(t('backupSuccess'));
          }
        } catch(err) { alert(t('invalidBackup')); }
      };
      reader.readAsText(file);
    }

    function saveLocalStorage() {
      try {
        const slim = window.playlists.map(pl => ({
          ...pl,
          tracks: pl.tracks.map(t => { const { fileData, ...rest } = t; return rest; })
        }));
        localStorage.setItem('corvexyn_studio_data', JSON.stringify({ playlists: slim, currentPlaylistId: window.currentPlaylistId }));
      } catch(e) {}
    }

    function loadLocalStorage() {
      try {
        const raw = localStorage.getItem('corvexyn_studio_data');
        if (raw) {
          const data = JSON.parse(raw);
          if (data.playlists) window.playlists = data.playlists;
          if (data.currentPlaylistId) window.currentPlaylistId = data.currentPlaylistId;
        }
      } catch(e) {}
    }

    function escapeHtml(str) {
      return !str ? '' : String(str).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
    }
  </script>
</body>
</html>
