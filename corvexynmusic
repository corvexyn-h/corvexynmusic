      initDB();
      loadLocalStorage();
      applyTheme(themeMode);
      applyDeviceMode(deviceMode);
      document.getElementById('lang-select').value = window.currentLang;
      updateLanguageUI();
      renderPlaylists();
      renderTracks();
      setupAudioListeners();
