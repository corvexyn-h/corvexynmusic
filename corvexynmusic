      initMelonStyleBackgroundEngine();
      setVolume(80);
      
      // 실시간 재생 위치 및 유튜브 종료 감지 루프
      setInterval(() => {
        if (!window.isPlaying) return;
        const tracks = getCurrentPlaylist().tracks;
        const track = tracks[window.currentTrackIndex];
        if (!track) return;
        
        if (track.type === 'youtube' && window.ytPlayer && typeof window.ytPlayer.getCurrentTime === 'function') {
          try {
            const curr = window.ytPlayer.getCurrentTime();
            const dur = window.ytPlayer.getDuration() || 0;
            if (dur > 0) {
              updateProgress(curr, dur);
              // 곡 끝나기 0.5초 전 혹은 종료 상태 감지 시 즉시 다음 곡으로 전환
              if (curr >= dur - 0.6) {
                handleTrackEnded();
              }
            }

            const ytState = window.ytPlayer.getPlayerState();
            if (ytState === YT.PlayerState.PAUSED && window.isPlaying) {
              window.isPlaying = false;
              updatePlayPauseUI();
            } else if (ytState === YT.PlayerState.PLAYING && !window.isPlaying) {
              window.isPlaying = true;
              updatePlayPauseUI();
            }
          } catch(e) {}
        }
      }, 100);
    }

    // [멜론 스타일] 백그라운드 끊김 방지 사운드 엔진 (Silent Audio Context Keep-Alive)
    let melonAudioCtx = null;
    let melonGainNode = null;

    function initMelonStyleBackgroundEngine() {
      try {
        const AudioContext = window.AudioContext || window.webkitAudioContext;
        if (AudioContext) {
          melonAudioCtx = new AudioContext();
          melonGainNode = melonAudioCtx.createGain();
          melonGainNode.gain.value = 0.0001; // 완전 무음 펄스로 백그라운드 세션 유지
          melonGainNode.connect(melonAudioCtx.destination);
          
          // 백그라운드 무한 유지 오실레이터 펄스
          const osc = melonAudioCtx.createOscillator();
          osc.type = 'sine';
          osc.frequency.value = 440;
          osc.connect(melonGainNode);
          osc.start();
        }
      } catch(e) {}
    }

    function triggerMelonKeepAlive() {
      if (melonAudioCtx && melonAudioCtx.state === 'suspended') {
        melonAudioCtx.resume();
      }
    }

    document.addEventListener('visibilitychange', () => {
      if (document.hidden && window.isPlaying) {
        triggerMelonKeepAlive();
        const tracks = getCurrentPlaylist().tracks;
        const track = tracks[window.currentTrackIndex];
        if (track && track.type === 'youtube' && window.ytPlayer) {
          try { window.ytPlayer.playVideo(); } catch(e) {}
        }
      }
    });

    function setupVolumeKeyListeners() {
      window.addEventListener('keydown', (e) => {
        const mainSlider = document.getElementById('volume-slider');
        if (!mainSlider) return;
        let currentVol = parseInt(mainSlider.value);

        if (e.key === 'AudioVolumeUp' || e.code === 'AudioVolumeUp' || e.keyCode === 175) {
          e.preventDefault();
          currentVol = Math.min(100, currentVol + 5);
          setVolume(currentVol);
        } else if (e.key === 'AudioVolumeDown' || e.code === 'AudioVolumeDown' || e.keyCode === 174) {
          e.preventDefault();
          currentVol = Math.max(0, currentVol - 5);
          setVolume(currentVol);
        } else if (e.key === 'AudioVolumeMute' || e.code === 'AudioVolumeMute' || e.keyCode === 173) {
          e.preventDefault();
          toggleMute();
        }
      });
    }

    function setupMediaSession() {
      if ('mediaSession' in navigator) {
        try {
          navigator.mediaSession.setActionHandler('play', () => { togglePlayPause(); });
          navigator.mediaSession.setActionHandler('pause', () => { togglePlayPause(); });
          navigator.mediaSession.setActionHandler('previoustrack', () => { playPrevTrack(); });
          navigator.mediaSession.setActionHandler('nexttrack', () => { playNextTrack(); });
          
          navigator.mediaSession.setActionHandler('seekbackward', null);
          navigator.mediaSession.setActionHandler('seekforward', null);
          navigator.mediaSession.setActionHandler('seekto', null);
        } catch(e) {}
      }
    }

